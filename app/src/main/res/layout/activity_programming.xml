<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vs_background"
    android:padding="20dp">

    <TextView
        android:id="@+id/programmingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Programming"
        android:textColor="@color/vs_text"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/programmingDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Learn the fundamentals of programming"
        android:textColor="@color/vs_text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/programmingTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/variablesButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:text="Variables"
        android:textColor="@color/vs_text"
        android:backgroundTint="@color/vs_surface_light"
        app:layout_constraintTop_toBottomOf="@id/programmingDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/ifButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="If Statements"
        android:textColor="@color/vs_text"
        android:backgroundTint="@color/vs_surface_light"
        app:layout_constraintTop_toBottomOf="@id/variablesButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/loopsButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="Loops"
        android:textColor="@color/vs_text"
        android:backgroundTint="@color/vs_surface_light"
        app:layout_constraintTop_toBottomOf="@id/ifButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/functionsButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="Functions"
        android:textColor="@color/vs_text"
        android:backgroundTint="@color/vs_surface_light"
        app:layout_constraintTop_toBottomOf="@id/loopsButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>