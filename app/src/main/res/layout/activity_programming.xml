<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/programmingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Programming"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/variablesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Variables"
            app:layout_constraintTop_toBottomOf="@id/programmingTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/ifButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="If Statements"
            app:layout_constraintTop_toBottomOf="@id/variablesButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/loopsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Loops"
            app:layout_constraintTop_toBottomOf="@id/ifButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/functionsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Functions"
            app:layout_constraintTop_toBottomOf="@id/loopsButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>